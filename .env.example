# Copy to .env and adjust. Never commit .env.

# PostgreSQL with the pgvector extension. `docker compose up -d --wait` starts one on port 5433 with the
# knowledge base pre-loaded (scripts/dev_db.sh starts an empty one). The defaults below need no .env.
ICR_DATABASE_URL=postgresql+psycopg://icr:icr_dev_password@127.0.0.1:5433/icr
ICR_TEST_DATABASE_URL=postgresql+psycopg://icr:icr_dev_password@127.0.0.1:5433/icr_test

# Paths
ICR_DATA_DIR=data

# OCR: either a native tesseract binary with Arabic data, or the container image built from
# docker/ocr.Containerfile (works on Linux, macOS and Windows; takes precedence when set):
#   docker build -t localhost/icr-tesseract:latest -f docker/ocr.Containerfile docker
ICR_OCR__TESSERACT_CMD=tesseract
# ICR_OCR__CONTAINER_IMAGE=localhost/icr-tesseract:latest
# ICR_OCR__CONTAINER_ENGINE=docker
ICR_OCR__DPI=300
ICR_OCR__LANGUAGES=ara+eng

# Chunking
ICR_CHUNKING__MAX_TOKENS=450
ICR_CHUNKING__MIN_TOKENS=40
ICR_CHUNKING__FALLBACK_OVERLAP_TOKENS=60

# Retrieval
# dense (default, measured best), hybrid or lexical; see docs/architecture.md section 5
ICR_RETRIEVAL__DEFAULT_MODE=dense
ICR_RETRIEVAL__EMBEDDING_MODEL=BAAI/bge-m3
# Optional cross-encoder (best quality, ~28 s/query on CPU): BAAI/bge-reranker-v2-m3
ICR_RETRIEVAL__RERANKER_MODEL=
ICR_RETRIEVAL__LEXICAL_WEIGHT=1.0
ICR_RETRIEVAL__RESOLVE_ARTICLE_REFERENCES=true
ICR_RETRIEVAL__DENSE_TOP_K=40
ICR_RETRIEVAL__LEXICAL_TOP_K=40
ICR_RETRIEVAL__RRF_K=60
ICR_RETRIEVAL__FINAL_TOP_K=10

# LLM provider: not selected yet. Generation is not implemented in this phase.
# ICR_LLM__PROVIDER=
# ICR_LLM__API_KEY=
